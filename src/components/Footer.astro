---
import { SITE, GROUPS, servicesIn, serviceUrl } from "../site";
import Star from "./Star.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer dark">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <img src="/images/brand/logo-white.png" alt="Bin Othaimeen Group" width="190" height="90" loading="lazy" />
        <p>
          Bin Othaimeen Group is a leading force in the GCC region, offering unparalleled expertise across diverse sectors. We
          are committed to excellence, innovation, and fostering enduring partnerships for success.
        </p>
        <div class="social">
          <a href={SITE.social.linkedin} rel="noopener" target="_blank" aria-label="Bin Othaimeen Group on LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zm7 0h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4z"></path></svg>
          </a>
          <a href={SITE.social.x} rel="noopener" target="_blank" aria-label="Bin Othaimeen Group on X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.77zm-1.08 16.2h1.7L7.4 4.72H5.58z"></path></svg>
          </a>
        </div>
      </div>

      {
        GROUPS.map((g) => (
          <div>
            <p class="col-title">{g.label}</p>
            <ul>
              {servicesIn(g.key).map((s) => (
                <li>
                  <a href={serviceUrl(s.slug)}>{s.menu}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <p class="col-title">Company</p>
        <ul>
          <li><a href="/company-overview/">Company overview</a></li>
          <li><a href="/company-overview/our-partners/">Partners</a></li>
          <li><a href="/company-overview/careers/">Careers</a></li>
          <li><a href="/leadcrystal/">Leadcrystal</a></li>
          <li><a href="/news/">News</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <p class="col-title">Get in touch</p>
        <address>
          {SITE.address.map((l) => <span>{l}</span>)}
        </address>
        <p><a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p class="hours">
          {SITE.hours.map(([d, h]) => <span>{d}: {h}</span>)}
        </p>
      </div>
    </div>

    <div class="bottom">
      <Star />
      <p>© {year} Bin Othaimeen Group. All rights reserved.</p>
      <p class="coords" aria-label="Riyadh coordinates">24.68° N · 46.62° E · Riyadh</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(64px, 8vw, 110px) 0 32px;
    font-size: 0.95rem;
  }
  .top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 0.8fr 1.1fr;
    gap: 40px;
  }
  .about img {
    height: 72px;
    width: auto;
    margin-bottom: 24px;
  }
  .about p {
    color: rgba(245, 241, 232, 0.66);
    max-width: 36ch;
  }
  .col-title {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin-bottom: 9px;
  }
  a {
    text-decoration: none;
    color: rgba(245, 241, 232, 0.82);
    transition: color 0.2s;
  }
  a:hover {
    color: var(--gold);
  }
  address {
    font-style: normal;
    display: grid;
    color: rgba(245, 241, 232, 0.82);
    margin-bottom: 14px;
  }
  .mail {
    color: var(--ivory);
    border-bottom: 1px solid rgba(226, 180, 92, 0.6);
  }
  .hours {
    display: grid;
    color: rgba(245, 241, 232, 0.6);
    font-size: 0.88rem;
  }
  .social {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line-dark);
    border-radius: 50%;
  }
  .social svg {
    width: 17px;
    height: 17px;
  }
  .bottom {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    color: rgba(245, 241, 232, 0.55);
    font-size: 0.82rem;
  }
  .bottom p {
    margin: 0;
  }
  .coords {
    margin-left: auto !important;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  @media (max-width: 1080px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .top {
      grid-template-columns: 1fr;
    }
    .bottom {
      flex-wrap: wrap;
    }
    .coords {
      margin-left: 0 !important;
      width: 100%;
    }
  }
</style>
