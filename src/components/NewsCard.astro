---
interface Props {
  post: { slug: string; title: string; date: string; excerpt: string; image: string | null; imageAlt: string };
  index?: number;
}
const { post, index = 0 } = Astro.props;
const date = new Date(post.date + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<article class="news" data-reveal style={`--d:${index}`}>
  <a href={`/${post.slug}/`}>
    {
      post.image && (
        <div class="img">
          <img src={`/images/posts/${post.slug}-640.webp`} alt={post.imageAlt || ""} width="640" height="400" loading="lazy" />
        </div>
      )
    }
    <time datetime={post.date}>{date}</time>
    <h3>{post.title}</h3>
    <p>{post.excerpt}</p>
    <span class="link-arrow">Read article <span aria-hidden="true">→</span></span>
  </a>
</article>

<style>
  a {
    display: block;
    text-decoration: none;
  }
  .img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    margin-bottom: 22px;
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  a:hover .img img {
    transform: scale(1.04);
  }
  time {
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }
  h3 {
    font-size: clamp(1.5rem, 2.3vw, 2rem);
    margin: 10px 0 12px;
    color: var(--indigo);
    transition: color 0.2s;
  }
  a:hover h3 {
    color: var(--indigo-2);
  }
  p {
    color: var(--muted);
  }
</style>
