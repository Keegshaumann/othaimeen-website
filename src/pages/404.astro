---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
---

<Base title="Page not found" noindex>
  <PageHero eyebrow="404" title="This page has moved or <em>no longer exists.</em>" lede="Our website has been rebuilt. Try one of these instead.">
    <div class="links">
      <a class="btn" href="/">Home</a>
      <a class="btn btn-ghost" href="/services/">Services</a>
      <a class="btn btn-ghost" href="/contact/">Contact</a>
    </div>
  </PageHero>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
